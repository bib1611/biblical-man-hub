# Biblical SEO Machine - API Configuration
# Copy this file to .env and fill in your actual keys

# OpenAI / Claude API (for content generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DataForSEO API (for SERP data, keyword metrics)
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password

# Google APIs (optional - for analytics integration)
GOOGLE_ANALYTICS_VIEW_ID=your_ga_view_id
GOOGLE_SEARCH_CONSOLE_SITE=your_site_url

# SerpAPI (alternative SERP data source)
SERPAPI_KEY=your_serpapi_key_here

# Substack (for future automation)
SUBSTACK_PUBLICATION_URL=https://biblicalman.substack.com

# Gumroad (for product optimization)
GUMROAD_ACCESS_TOKEN=your_gumroad_token
